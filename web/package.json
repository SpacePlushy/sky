{
  "name": "sky-over-phoenix-web",
  "private": true,
  "version": "0.0.0",
  "description": "Dashboard for Sky Over Phoenix: map, telemetry, passes, and sky plot over the Sky.Api endpoints.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
